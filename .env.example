# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-very-long-random-secret-32-chars
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Email delivery
EMAIL_FROM="Cord <noreply@localhost>"
RESEND_API_KEY=

# Storage (optional)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=cord-media
S3_REGION=us-east-1

# WebRTC / signaling
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# Demo seed credentials (set explicitly before running npm run prisma:seed)
DEMO_EMAIL=demo@cord.app
DEMO_USERNAME=cord_demo
DEMO_PASSWORD=replace-with-a-strong-demo-password
